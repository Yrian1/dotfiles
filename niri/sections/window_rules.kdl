// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Window-Rules
window-rule {
    match app-id=r#"^brave*"#
}

window-rule {
  //This disables the background rendering of borders and focus 
  //rings, making them appear only around the window. 
  draw-border-with-background false
  // Rounded corners for a modern look.
  geometry-corner-radius 8

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true
}

window-rule {
    match app-id=r#"pavucontrol"#
    open-floating true

    default-floating-position x=0 y=-15 relative-to="bottom"
    default-column-width { proportion 0.50; }
    default-window-height { proportion 0.50; }
    focus-ring { off ;}

}

// Open the vivaldi picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host vivaldi (app-id is "vivaldi")
    // - Flatpak vivaldi (app-id is "org.mozilla.vivaldi")
    match app-id=r#""# title="^Picture in picture$"
    open-floating true
    default-column-width { proportion 0.38; }
    default-window-height { proportion 0.38; }
    //default-floating-position x=300 y=250 relative-to="top-right"
    
    default-floating-position x=45 y=45 relative-to="top-right"
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

/-window-rule {
    geometry-corner-radius 1
    clip-to-geometry true
}

